---
import { FORM_ENDPOINT, FORM_METHOD, FORM_SUCCESS_PATH, LINKS } from "../site.config";
import check1 from "../assets/figma-section-15/check-1.svg";
import check2 from "../assets/figma-section-15/check-2.svg";
import check3 from "../assets/figma-section-15/check-3.svg";
import check4 from "../assets/figma-section-15/check-4.svg";
import arrowRight from "../assets/figma-section-15/arrow-right.svg";

const aparelhos = ["Chuveiro", "Ar-condicionado", "Empresas", "Máquinas", "Geladeiras", "Computadores", "Equipamentos", "Luzes", "Tomadas"];
const fatos = [
  { texto: "Os consumidores já existem.", icon: check1 },
  { texto: "A necessidade já existe.", icon: check2 },
  { texto: "O consumo já existe.", icon: check3 },
  { texto: "A conta já existe.", icon: check4 },
];
const formAtivo = FORM_ENDPOINT !== "";
---

<section class="fechamento" id="aplicacao" data-node-id="1048:8047">
  <div class="fechamento__inner">
    <div class="fechamento__top reveal">
      <header><h2>A conta de energia vai continuar chegando</h2><p>Amanhã milhões de pessoas vão ligar:</p></header>
      <ul class="aparelhos" data-stagger>{aparelhos.map((item) => <li>{item}</li>)}</ul>
      <strong class="consumindo">E continuar consumindo energia</strong>
    </div>

    <div class="fechamento__grid">
      <div class="fechamento__copy reveal">
        <h3>Esse mercado não precisa<br />ser criado, ele já existe.</h3>
        <ul class="fatos" data-stagger>{fatos.map((item) => <li><img src={item.icon.src} alt="" /><strong>{item.texto}</strong></li>)}</ul>
        <p class="descoberta">E agora você descobriu que existe uma<br />forma de participar desse mercado.</p>
        <p class="pergunta-label">Então existe uma pergunta que só você pode responder.</p>
        <div class="pergunta">
          <p>Você vai continuar apenas pagando sua conta de energia?</p>
          <strong>Ou vai aprender como transformar esse<br />mercado em uma nova fonte de renda?</strong>
        </div>
      </div>

      <div class="form-wrap reveal">
        <h3>Preencha o formulário e<br />descubra como começar como<br />Consultor de Energia Hive.</h3>
        <form
          action={formAtivo ? FORM_ENDPOINT : undefined}
          method={formAtivo ? FORM_METHOD : undefined}
          data-lead-form
          data-endpoint={FORM_ENDPOINT}
          data-success-path={FORM_SUCCESS_PATH}
        >
          <input type="hidden" name="form_id" value="hive_energy_landing" />
          <div class="field"><label for="nome">Nome</label><input id="nome" name="nome" type="text" autocomplete="name" required /></div>
          <div class="field"><label for="whatsapp">WhatsApp</label><input id="whatsapp" name="whatsapp" type="tel" inputmode="tel" autocomplete="tel" required /></div>
          <div class="field"><label for="email">E-mail</label><input id="email" name="email" type="email" autocomplete="email" required /></div>
          <div class="consent">
            <input id="consent" name="consent" type="checkbox" required />
            <label for="consent">Autorizo o contato e o tratamento dos meus dados conforme a {LINKS.privacidade ? <a href={LINKS.privacidade}>política de privacidade</a> : <span>política de privacidade</span>}.</label>
          </div>
          <button type="submit" disabled={!formAtivo}>Quero conhecer essa oportunidade <img src={arrowRight.src} alt="" /></button>
          <p class="form-status" data-form-status role="status" aria-live="polite"></p>
          {!formAtivo && <p class="pendente">Formulário em modo demonstração: configure <code>FORM_ENDPOINT</code> em <code>src/site.config.ts</code> para ativar o envio.</p>}
        </form>
      </div>
    </div>
  </div>
</section>

<style>
  .fechamento { padding: 90px var(--gutter); overflow-x: clip; background: #0e0a15; color: #fff; }
  .fechamento__inner { width: min(100%,1305px); margin-inline: auto; display: grid; gap: 80px; }
  .fechamento__top { display: grid; justify-items: center; gap: 40px; }
  .fechamento__top header { width: min(100%,1022px); display: grid; justify-items: center; gap: 40px; text-align: center; }
  .fechamento__top h2 { font-size: 50px; line-height: 52.5px; letter-spacing: -1.5px; font-weight: 700; text-align: center; }
  .fechamento__top header p { color: rgba(255,255,255,.72); font-size: 29.643px; line-height: 47.428px; letter-spacing: -.6947px; }
  .aparelhos { width: 100%; display: grid; grid-template-columns: repeat(20,1fr); gap: 20px; }
  .aparelhos li { grid-column: span 4; height: 51px; padding: 16px 24px; display: flex; align-items: center; justify-content: center; border-radius: 16px; background: rgba(255,255,255,.05); font-size: 24px; line-height: 1.1; letter-spacing: -.72px; }
  .aparelhos li:nth-child(n+6) { grid-column: span 5; }
  .consumindo { min-height: 90.954px; padding: 28.477px 42.716px; border-radius: 28.477px; background: #7355e8; font-size: 46.275px; line-height: 45.563px; letter-spacing: -1.3883px; text-align: center; }
  .fechamento__grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; align-items: center; }
  .fechamento__copy { display: grid; gap: 25px; }
  .fechamento__copy > h3 { background: linear-gradient(122deg,#c6b5ff 4%,#7f60fd 96%); -webkit-background-clip: text; background-clip: text; color: transparent; font-size: 52px; line-height: 53.04px; letter-spacing: -1.7499px; font-weight: 700; }
  .fatos { display: grid; gap: 13px; }
  .fatos li { display: flex; align-items: center; gap: 19px; min-height: 40px; }
  .fatos img { width: 25px; height: 25px; }
  .fatos strong { font-size: 25.029px; line-height: 40.046px; letter-spacing: -.7509px; }
  .descoberta { color: rgba(255,255,255,.72); font-size: 29.132px; line-height: 46.611px; letter-spacing: -.874px; }
  .pergunta-label { font-size: 22px; line-height: 1.6; letter-spacing: -.66px; font-weight: 700; }
  .pergunta { padding: 32px; border-radius: 24px; background: rgba(255,255,255,.05); display: grid; gap: 15px; }
  .pergunta p { color: rgba(255,255,255,.72); font-size: 22px; line-height: 1.4; letter-spacing: -.03em; }
  .pergunta strong { padding-top: 12px; font-size: 31px; line-height: 43.4px; letter-spacing: -.93px; }
  .form-wrap { padding: 49.423px; border-radius: 39.538px; background: #fff; color: #0e0a15; }
  .form-wrap > h3 { font-size: 34.596px; line-height: 34.596px; letter-spacing: -.7379px; font-weight: 700; }
  form { display: grid; gap: 19.769px; margin-top: 39.538px; }
  .field { display: grid; gap: 10px; }
  .field label { font-size: 17.298px; line-height: 27.677px; letter-spacing: -.1858px; }
  .field input { min-height: 59.308px; padding: 12px 16px; border: 1.236px solid #e6e3ec; border-radius: 14.827px; background: #f7f6f9; font-size: 16px; }
  .field input:focus-visible { border-color: #7355e8; outline: 3px solid rgba(115,85,232,.25); outline-offset: 0; }
  .consent { display: flex; align-items: flex-start; gap: 10px; padding-top: 5px; }
  .consent input { flex: none; width: 24.712px; height: 24.712px; margin-top: 3px; accent-color: #7355e8; }
  .consent label { color: #514b5e; font-size: 13px; line-height: 25.947px; letter-spacing: -.39px; }
  .consent a { color: #7355e8; text-decoration: underline; }
  button { min-height: 64.25px; padding: 14.827px 39.538px; border: 0; border-radius: 1234px; background: #7355e8; color: #fff; display: flex; align-items: center; justify-content: center; gap: 15px; font-size: 19.769px; line-height: 31.631px; letter-spacing: -.5838px; font-weight: 700; cursor: pointer; }
  button img { width: 22px; height: 22px; }
  button:disabled { opacity: .55; cursor: not-allowed; }
  .pendente { padding: 10px 14px; border: 1px dashed #e6e3ec; border-radius: 12px; color: #514b5e; font-size: 12px; line-height: 1.5; }
  .form-status { min-height: 1.4em; color: #514b5e; font-size: 13px; line-height: 1.4; text-align: center; }
  .form-status[data-state="error"] { color: #a32929; }
  @media (max-width: 1350px) {
    .fechamento__top h2 { font-size: 50px; }
    .fechamento__top header p { font-size: clamp(22px,2.2vw,29.643px); }
    .aparelhos li { font-size: 24px; }
    .consumindo { font-size: clamp(29px,3.43vw,46.275px); }
    .fechamento__copy > h3 { font-size: clamp(36px,3.85vw,52px); }
    .fatos strong { font-size: clamp(19px,1.85vw,25.029px); }
    .descoberta { font-size: clamp(21px,2.16vw,29.132px); }
    .pergunta-label { font-size: 22px; }
    .pergunta strong { font-size: clamp(25px,2.3vw,31px); }
    .form-wrap > h3 { font-size: clamp(27px,2.56vw,34.596px); }
  }
  @media (max-width: 920px) {
    .fechamento__grid { grid-template-columns: 1fr; gap: 50px; }
    .fechamento__copy h3 br, .descoberta br, .pergunta strong br, .form-wrap h3 br { display: none; }
  }
  @media (max-width: 700px) {
    .fechamento { padding-block: 72px; }
    .fechamento__inner {
      gap: 60px;
      width: min(340px, 100%);
    }

    .fechamento__top,
    .fechamento__top header,
    .fechamento__grid,
    .fechamento__copy,
    .form-wrap {
      width: 100%;
      max-width: 340px;
      margin-inline: auto;
    }

    .fechamento__top h2,
    .fechamento__copy > h3,
    .descoberta,
    .pergunta-label,
    .pergunta,
    .form-wrap > h3 {
      width: 100%;
      letter-spacing: -0.03em;
    }

    .fechamento__top h2 {
      width: 90%;
      max-width: 340px;
      margin-inline: auto;
      font-size: 28px;
      line-height: 1.08;
      text-wrap: balance;
    }

    .fechamento__top header p {
      width: 80%;
      max-width: 340px;
      margin-inline: auto;
      font-size: 16px;
      line-height: 1.2;
      white-space: nowrap;
    }

    .aparelhos { grid-template-columns: 1fr 1fr; gap: 10px; }
    .aparelhos,
    .fatos,
    .pergunta,
    form {
      width: 100%;
    }

    .aparelhos li,
    .aparelhos li:nth-child(n+6),
    .fatos li {
      width: 100%;
    }

    .aparelhos li, .aparelhos li:nth-child(n+6) { grid-column: auto; padding: 12px; font-size: 15px; }
    .aparelhos li:last-child { grid-column: 1/-1; }
    .consumindo {
      width: 100%;
      max-width: 340px;
      padding: 22px;
      border-radius: 22px;
      font-size: 18px;
      line-height: 1.2;
      white-space: nowrap;
    }

    .fechamento__copy > h3 {
      font-size: 26px;
      line-height: 1.08;
      text-align: center;
    }

    .descoberta {
      font-size: 17px;
      line-height: 1.25;
      text-align: center;
      text-wrap: balance;
    }

    .fechamento .descoberta br,
    .fechamento .pergunta strong br,
    .fechamento .form-wrap > h3 br {
      display: none !important;
    }

    .form-wrap > h3 {
      font-size: 24px;
      line-height: 1.2;
      text-align: center;
      text-wrap: balance;
      overflow-wrap: normal;
      word-break: normal;
      hyphens: none;
    }

    .pergunta strong {
      width: 100%;
      font-size: 16px;
      line-height: 1.25;
      text-align: center;
      text-wrap: balance;
    }

    .form-wrap { padding: 34px 22px; border-radius: 28px; }
    button { padding-inline: 22px; font-size: 15px; }
  }
</style>

<script>
  const leadForm = document.querySelector<HTMLFormElement>("[data-lead-form]");

  if (leadForm) {
    const submitButton = leadForm.querySelector<HTMLButtonElement>('button[type="submit"]');
    const status = leadForm.querySelector<HTMLElement>("[data-form-status]");

    leadForm.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!leadForm.reportValidity() || !submitButton) return;

      const endpoint = leadForm.dataset.endpoint;
      const successPath = leadForm.dataset.successPath || "/obrigado/";
      if (!endpoint) return;

      submitButton.disabled = true;
      submitButton.setAttribute("aria-busy", "true");
      if (status) {
        status.dataset.state = "loading";
        status.textContent = "Enviando seus dados…";
      }

      const payload = new URLSearchParams();
      const data = new FormData(leadForm);
      data.forEach((value, key) => {
        if (typeof value === "string") payload.set(key, value);
      });

      const query = new URLSearchParams(window.location.search);
      [
        "utm_source",
        "utm_medium",
        "utm_campaign",
        "utm_content",
        "utm_term",
        "conjunto",
        "anuncio",
        "fbclid",
        "gclid",
      ].forEach((key) => {
        const value = query.get(key);
        if (value) payload.set(key, value);
      });

      payload.set("consentimento", "sim");
      payload.set("pagina", window.location.href);
      payload.set("origem", document.referrer || "acesso_direto");
      payload.set("enviado_em", new Date().toISOString());

      try {
        await fetch(endpoint, {
          method: "POST",
          mode: "no-cors",
          keepalive: true,
          body: payload,
        });

        let redirecionando = false;
        const redirecionar = () => {
          if (redirecionando) return;
          redirecionando = true;
          window.location.assign(successPath);
        };

        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({
          event: "FormSubmit",
          form_id: "hive_energy_landing",
          eventCallback: redirecionar,
          eventTimeout: 1600,
        });

        window.setTimeout(redirecionar, 1800);
      } catch (error) {
        submitButton.disabled = false;
        submitButton.removeAttribute("aria-busy");
        if (status) {
          status.dataset.state = "error";
          status.textContent = "Não foi possível enviar agora. Verifique sua conexão e tente novamente.";
        }
        console.error("[lead-form]", error);
      }
    });
  }
</script>
