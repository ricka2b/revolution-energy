---
import hero from "../assets/hive-hero.jpg";
import heroVideo from "../assets/hero-landing-optimized.webm";
import Icon from "./Icon.astro";
import { CTA_ANCHOR } from "../site.config";

const naoPrecisa = [
  "Sem instalar placa solar.",
  "Sem precisar entender de energia.",
  "Apenas oferecendo um benefício real.",
];
---

<section class="hero" id="inicio">
  <div class="hero__media" data-hero-media>
    <video
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster={hero.src}
      aria-hidden="true"
    >
      <source src={heroVideo} type="video/webm" />
    </video>
  </div>

  <div class="hero__inner container">
    <div class="hero__copy">
      <h1 data-hero-title>
        <span class="headline-line">Descubra como ganhar de</span>
        <span class="headline-line">
          <strong>3 a 15 mil reais</strong> todos os meses.
        </span>
      </h1>

      <p class="hero__lead" data-hero-item>
        <span>Vou te mostrar o passo a passo para conquistar clientes, gerar economia na conta de energia</span>
        <span>e criar uma carteira que paga comissões todos os meses, mesmo começando do zero.</span>
      </p>

      <ul class="hero__chips">
        {
          naoPrecisa.map((item) => (
            <li data-hero-chip>
              <Icon name="check" size={16} />
              {item}
            </li>
          ))
        }
      </ul>

      <a class="btn hero__cta" href={CTA_ANCHOR} data-hero-item>
        Quero entender essa oportunidade
        <Icon name="arrow-right" size={18} />
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: min(52rem, calc(100svh - var(--bar-h) - 1.5rem));
    margin: clamp(0.5rem, 1.2vw, 0.75rem);
    padding-block: clamp(4.5rem, 9vw, 7rem);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: clamp(1.25rem, 2.4vw, 2rem);
    background: var(--dark);
    color: var(--on-dark);
    overflow: hidden;
    isolation: isolate;
    box-shadow: 0 1.5rem 4rem rgba(14, 10, 21, 0.16);
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    will-change: transform;
  }

  .hero__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
  }

  /* Véu que garante contraste do texto sobre a foto. */
  .hero::after {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(7, 4, 12, 0.38), rgba(7, 4, 12, 0.58)),
      radial-gradient(
        72% 68% at 50% 22%,
        rgba(127, 96, 253, 0.2),
        transparent 70%
      );
    content: "";
  }

  .hero__inner {
    position: relative;
    display: grid;
    justify-items: center;
  }

  .hero__copy {
    display: grid;
    justify-items: center;
    width: 100%;
    max-width: 72rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(2.125rem, 4.4vw, 3.5rem);
    font-weight: 700;
    letter-spacing: -0.052em;
    line-height: 1.01;
  }

  /* Duas linhas fixas em telas que comportam a composição. */
  @media (min-width: 48rem) {
    .hero h1 .headline-line {
      /* Bloco por linha: a quebra deixa de depender da largura disponível.
         `fit-content` mantém cada linha colada ao próprio texto. */
      display: block;
      width: fit-content;
      margin-inline: auto;
      white-space: nowrap;
    }
  }

  .hero h1 strong {
    font-weight: 700;
    color: var(--purple-soft);
  }

  .hero__lead {
    width: 100%;
    max-width: none;
    margin-top: var(--space-6);
    color: rgba(255, 255, 255, 0.78);
    font-size: clamp(0.9375rem, 1.35vw, 1.0625rem);
    font-weight: 400;
    letter-spacing: -0.02em;
    line-height: 1.55;
  }

  @media (min-width: 48rem) {
    .hero__lead span {
      display: block;
      white-space: nowrap;
    }
  }

  /* Chips de vidro: fundo translúcido + blur, bem sutil. */
  .hero__chips {
    justify-content: center;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-top: var(--space-6);
  }

  .hero__chips li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.625rem 1rem;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-pill);
    background: rgba(14, 10, 21, 0.2);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08);
    color: rgba(255, 255, 255, 0.86);
    font-size: clamp(0.875rem, 0.25vw + 0.82rem, 0.9375rem);
    font-weight: 500;
    line-height: 1.25;
    white-space: nowrap;
  }

  @supports (backdrop-filter: blur(10px)) {
    .hero__chips li {
      background: rgba(255, 255, 255, 0.05);
      backdrop-filter: blur(10px) saturate(1.3);
    }
  }

  .hero__chips :global(svg) {
    flex: none;
    color: var(--purple-soft);
  }

  .hero__cta {
    margin-top: var(--space-6);
    padding: 0.375rem 0.375rem 0.375rem 1.5rem;
    background: #fff;
    color: var(--dark);
    box-shadow: 0 1rem 2.5rem rgba(0, 0, 0, 0.18);
  }

  .hero__cta :global(svg) {
    box-sizing: content-box;
    padding: 0.5rem;
    border-radius: 50%;
    background: var(--action);
    color: #fff;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__cta:hover {
      background: var(--lavender);
      box-shadow: 0 1.25rem 3rem rgba(0, 0, 0, 0.24);
    }
  }

  @media (max-width: 48rem) {
    .hero {
      min-height: calc(100svh - var(--bar-h) - 1rem);
      margin: 0.5rem;
      padding-block: 4rem;
    }

    .hero__media video {
      object-position: 52% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media video {
      display: none;
    }
  }

  /* Abaixo de 26rem nem três linhas cabem sem apertar: libera a quebra. */
  @media (max-width: 26rem) {
    .hero__chips li {
      white-space: normal;
    }
  }
</style>
