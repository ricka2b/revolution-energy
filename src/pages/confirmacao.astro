---
import Layout from "../layouts/Layout.astro";
import { CONFIRMATION_FORM_ENDPOINT } from "../site.config";
import confirmationBackground from "../assets/confirmacao/background.png";
import confirmationBackgroundMobile from "../assets/confirmacao/background-mobile.webp";
import revealWordmark from "../assets/confirmacao/revelacao.png";
import revealEyebrow from "../assets/confirmacao/divider.svg";

const formAtivo = CONFIRMATION_FORM_ENDPOINT !== "";
---

<Layout
  title="Confirme sua presença | Hive Energy"
  description="Confirme sua presença no evento Hive Energy."
  showAnnouncement={false}
  enableMotion={false}
>
  <main id="conteudo" class="confirmacao">
    <img class="confirmacao__background confirmacao__background--desktop" src={confirmationBackground.src} alt="" aria-hidden="true" />
    <img class="confirmacao__background confirmacao__background--mobile" src={confirmationBackgroundMobile.src} alt="" aria-hidden="true" />

    <section class="confirmacao__content" aria-labelledby="confirmacao-titulo">
      <div class="reveal-brand" aria-label="Chá revelação: menino ou menina?">
        <img class="reveal-brand__eyebrow" src={revealEyebrow.src} alt="" aria-hidden="true" />
        <div class="reveal-brand__wordmark-frame" aria-hidden="true">
          <div class="reveal-brand__wordmark">
            <span class="reveal-brand__slice reveal-brand__slice--boy"><img src={revealWordmark.src} alt="" /></span>
            <span class="reveal-brand__slice reveal-brand__slice--or"><img src={revealWordmark.src} alt="" /></span>
            <span class="reveal-brand__slice reveal-brand__slice--girl"><img src={revealWordmark.src} alt="" /></span>
          </div>
        </div>
      </div>

      <header class="confirmacao__header">
        <h1 id="confirmacao-titulo">Confirmar Presença</h1>
        <p>Preencha seus dados abaixo e confirme sua presença</p>
      </header>

      <form
        class="confirmacao__card"
        data-confirmation-form
        data-endpoint={CONFIRMATION_FORM_ENDPOINT}
        novalidate
      >
        <input type="hidden" name="form_id" value="hive_event_confirmation" />

        <div class="confirmation-step" data-step="nome">
          <div class="field-group">
            <label for="nome-confirmacao">Nome</label>
            <input id="nome-confirmacao" name="nome" type="text" placeholder="Insira seu nome completo" autocomplete="name" required />
          </div>
          <button class="button" type="button" data-continue>Continuar →</button>
        </div>

        <div class="confirmation-step is-hidden" data-step="escolha" aria-live="polite">
          <p class="confirmacao__question">Você irá levar convidados?</p>
          <div class="choice-group" role="group" aria-label="Você vai levar convidados?">
            <button class="choice" type="button" data-guest-choice="sim">Sim</button>
            <button class="choice" type="button" data-guest-choice="nao">Não</button>
          </div>
        </div>

        <div class="confirmation-step is-hidden" data-step="convidados" aria-live="polite">
          <div class="guests" data-guests>
            <p class="guests__label">Nome do convidado</p>
            <div class="guests__fields" data-guest-fields></div>
            <button class="add-guest" type="button" data-add-guest>+ Adicionar convidado</button>
          </div>
          <button class="button button--confirm" type="submit" data-confirm>Confirmar Presença →</button>
        </div>

        <div class="confirmation-success is-hidden" data-success role="status" aria-live="polite">
          <span class="confirmation-success__check" aria-hidden="true">✓</span>
          <h2>Presença confirmada!</h2>
          <p class="confirmation-success__intro">Estamos esperando você para esse momento tão especial.</p>
          <div class="confirmation-success__reminder">
            <strong>Um lembrete carinhoso:</strong>
            <span>Não se esqueça de levar uma lembrancinha para o bebê, como fraldas ou lenços umedecidos.</span>
          </div>
        </div>

        <p class="form-status" data-form-status role="status" aria-live="polite"></p>
        {!formAtivo && <p class="form-status">O formulário está em modo demonstração.</p>}
      </form>
    </section>
  </main>
</Layout>

<style>
  .confirmacao {
    position: relative;
    display: grid;
    min-height: 100svh;
    overflow-x: clip;
    overflow-y: auto;
    isolation: isolate;
    place-items: center;
    padding: 32px 20px;
    background: #f9efe5;
    color: #483319;
  }
  .confirmacao__background {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    pointer-events: none;
  }
  .confirmacao__background--mobile { display: none; }
  .confirmacao__content { position: relative; z-index: 1; width: min(100%, 464px); min-width: 0; display: flex; flex-direction: column; align-items: center; gap: 30px; }
  .reveal-brand { display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .reveal-brand__eyebrow { display: block; width: 268.487px; height: 15.154px; }
  .reveal-brand__wordmark-frame { position: relative; width: 467px; height: 40.247px; }
  .reveal-brand__wordmark { position: absolute; inset: 0; width: 467px; height: 40.247px; }
  .reveal-brand__slice { position: absolute; display: block; width: 215.051px; overflow: hidden; }
  .reveal-brand__slice img { position: absolute; left: 0; width: 100%; max-width: none; }
  .reveal-brand__slice--boy { top: 0; left: 0; height: 40.247px; }
  .reveal-brand__slice--boy img { top: -148.59%; height: 443.57%; }
  .reveal-brand__slice--or { top: 8.11px; left: 126.29px; height: 24.023px; }
  .reveal-brand__slice--or img { top: -453.62%; height: 743.15%; }
  .reveal-brand__slice--girl { top: .79px; left: 251.9px; height: 38.668px; }
  .reveal-brand__slice--girl img { top: -361.7%; height: 461.7%; }
  .confirmacao__header { display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .confirmacao h1 { color: #a06e2f; font-size: 46.251px; font-weight: 700; letter-spacing: -1.3875px; line-height: 50.877px; white-space: nowrap; }
  .confirmacao__header > p { color: rgba(160,110,47,.55); font-size: 16.859px; font-weight: 400; line-height: 22.76px; white-space: nowrap; }
  .confirmacao__card { width: 100%; min-width: 0; padding: 40px; border: 1px solid rgba(160,110,47,.08); border-radius: 24px; background: linear-gradient(180deg, rgba(160,110,47,.03), transparent), rgba(160,110,47,.04); box-shadow: 0 16px 64px rgba(0,0,0,.5); backdrop-filter: blur(40px); }
  .confirmation-step { display: flex; flex-direction: column; gap: 20px; animation: step-in .45s ease both; }
  .confirmation-step[data-step="nome"] { align-items: flex-end; }
  .field-group { width: 100%; display: flex; flex-direction: column; gap: 10px; padding-top: 4px; }
  .field-group > label, .guests__label { align-self: flex-start; color: rgba(160,110,47,.7); font-size: 14px; font-weight: 400; letter-spacing: .35px; line-height: 20px; }
  .confirmation-step input { width: 100%; height: 54px; padding: 14px 16px; border: 1px solid rgba(160,110,47,.12); border-radius: 20px; background: rgba(160,110,47,.17); color: #483319; font: inherit; font-size: 16px; letter-spacing: -.48px; }
  .confirmation-step input::placeholder { color: rgba(72,51,25,.55); }
  .confirmation-step input:focus-visible { border-color: rgba(160,110,47,.56); outline: 3px solid rgba(231,184,125,.26); }
  .button { min-height: 47.15px; padding: 11.576px 30px; border: 0; border-radius: 999px; display: inline-flex; align-items: center; justify-content: center; background: #e7b87d; color: #fff; font: inherit; font-size: 16.207px; font-weight: 500; letter-spacing: -.4862px; line-height: 24.31px; cursor: pointer; transition: transform .2s ease, filter .2s ease; }
  .button:hover { filter: brightness(.96); transform: translateY(-1px); }
  .button--confirm { width: 100%; }
  .confirmacao__question { color: #483319; font-size: 20.838px; font-weight: 700; letter-spacing: .4052px; line-height: 23.153px; white-space: nowrap; }
  .confirmation-step[data-step="escolha"] { width: fit-content; margin-inline: auto; align-items: center; }
  .confirmation-step[data-step="convidados"] { width: 100%; align-items: flex-start; gap: 15px; }
  .choice-group { display: flex; gap: 17.365px; }
  .choice { min-width: 133px; min-height: 47.15px; padding: 11.576px 46.306px; border: 0; border-radius: 999px; background: #e7b87d; color: #fff; font: inherit; font-size: 16.207px; font-weight: 700; letter-spacing: .4052px; line-height: 24.31px; cursor: pointer; transition: transform .2s ease, filter .2s ease; }
  .choice:hover, .choice[aria-pressed="true"] { filter: brightness(.96); transform: translateY(-1px); }
  .guests { width: 100%; display: flex; flex-direction: column; gap: 15px; }
  .guests__label { display: none; }
  .guests__fields { display: flex; flex-direction: column; gap: 15px; }
  .guests__fields :global(.guest-field) { display: flex; flex-direction: column; gap: 10px; padding-top: 4px; }
  .guests__fields :global(.guest-field > label) { color: rgba(160,110,47,.7); font-size: 14px; font-weight: 400; letter-spacing: .35px; line-height: 20px; }
  .guests__fields :global(.guest-input) { width: 100%; height: 54px; padding: 14px 16px; border: 1px solid rgba(160,110,47,.12); border-radius: 20px; background: rgba(160,110,47,.17); color: #483319; font: inherit; font-size: 16px; letter-spacing: -.48px; }
  .guests__fields :global(.guest-input::placeholder) { color: rgba(72,51,25,.55); }
  .guests__fields :global(.guest-input:focus-visible) { border-color: rgba(160,110,47,.56); outline: 3px solid rgba(231,184,125,.26); }
  .add-guest { align-self: flex-start; padding: 0; border: 0; background: transparent; color: #a56d17; font: inherit; font-size: 14px; font-weight: 500; letter-spacing: -.42px; line-height: 20px; cursor: pointer; }
  .confirmation-success { display: grid; min-height: 236px; place-items: center; align-content: center; gap: 10px; text-align: center; animation: step-in .45s ease both; }
  .confirmation-success__check { display: grid; width: 44px; height: 44px; place-items: center; border-radius: 50%; background: #e7b87d; color: #fff; font-size: 23px; font-weight: 700; }
  .confirmation-success h2 { color: #a06e2f; font-size: 28px; font-weight: 700; letter-spacing: -.84px; }
  .confirmation-success__intro, .form-status { color: rgba(72,51,25,.72); font-size: 14px; line-height: 20px; text-align: center; }
  .confirmation-success__reminder { display: grid; max-width: 330px; gap: 4px; margin-top: 6px; padding: 14px 18px; border-radius: 16px; background: rgba(231,184,125,.2); color: #6e4b20; font-size: 13.5px; line-height: 18px; }
  .confirmation-success__reminder strong { color: #a06e2f; font-size: 14px; }
  .form-status { min-height: 0; }
  .form-status:empty { display: none; }
  .form-status[data-state="error"] { margin-top: 12px; color: #a42b2b; }
  .is-hidden { display: none !important; }
  @keyframes step-in { from { opacity: 0; transform: translateY(8px); } }
  @media (max-width: 767px) {
    .confirmacao {
      align-items: start;
      min-height: 100svh;
      padding: max(20px, env(safe-area-inset-top)) 16px max(20px, env(safe-area-inset-bottom));
    }
    .confirmacao__background--desktop { display: none; }
    .confirmacao__background--mobile { display: block; object-position: center; }
    .confirmacao__content {
      width: min(100%, 380px);
      min-height: calc(100svh - 40px);
      justify-content: center;
      gap: 18px;
    }
    .reveal-brand { width: min(100%, 320px); gap: 7px; }
    .reveal-brand__eyebrow { width: 210px; height: auto; }
    .reveal-brand__wordmark-frame { width: 320px; height: 28px; margin-block: -3px -7px; overflow: visible; }
    .reveal-brand__wordmark {
      top: 0;
      left: 50%;
      right: auto;
      bottom: auto;
      width: 467px;
      transform: translateX(-50%) scale(.68);
      transform-origin: top center;
    }
    .confirmacao__header { gap: 6px; }
    .confirmacao h1 { font-size: clamp(31px, 9vw, 36px); line-height: 1.08; letter-spacing: -.03em; }
    .confirmacao__header > p { max-width: 330px; font-size: 13.5px; line-height: 1.35; white-space: normal; }
    .confirmacao__card { padding: 22px 18px; border-radius: 20px; box-shadow: 0 12px 38px rgba(72,51,25,.28); }
    .confirmation-step { gap: 16px; }
    .field-group, .guests__fields :global(.guest-field) { gap: 7px; padding-top: 0; }
    .confirmation-step input, .guests__fields :global(.guest-input) { height: 50px; padding: 12px 14px; border-radius: 16px; font-size: 15px; }
    .button { min-height: 45px; padding: 10px 24px; font-size: 15px; }
    .confirmacao__question { width: 100%; font-size: 18px; line-height: 1.2; text-align: center; white-space: normal; }
    .confirmation-step[data-step="escolha"] { width: 100%; }
    .choice-group { width: 100%; gap: 10px; }
    .choice { flex: 1; min-width: 0; min-height: 45px; padding: 10px 18px; font-size: 15px; }
    .guests, .guests__fields { gap: 12px; }
    .confirmation-step[data-step="convidados"] { gap: 13px; }
    .confirmation-success { min-height: 225px; gap: 8px; }
    .confirmation-success__check { width: 40px; height: 40px; font-size: 21px; }
    .confirmation-success h2 { font-size: 25px; }
    .confirmation-success__intro { max-width: 280px; font-size: 13.5px; }
    .confirmation-success__reminder { max-width: 100%; padding: 12px 14px; font-size: 13px; line-height: 17px; }
  }
  @media (max-width: 380px) {
    .confirmacao { padding-inline: 12px; }
    .confirmacao__content { gap: 15px; }
    .reveal-brand__eyebrow { width: 190px; }
    .reveal-brand__wordmark-frame { width: 290px; height: 25px; margin-bottom: -9px; }
    .reveal-brand__wordmark { transform: translateX(-50%) scale(.62); }
    .confirmacao h1 { font-size: 29px; }
    .confirmacao__header > p { max-width: 290px; font-size: 12.5px; }
    .confirmacao__card { padding: 20px 16px; }
  }
  @media (max-width: 767px) and (max-height: 700px) {
    .confirmacao__background--mobile { object-position: center top; }
    .confirmacao__content { justify-content: flex-start; gap: 14px; }
    .reveal-brand__eyebrow { width: 185px; }
    .reveal-brand__wordmark-frame { width: 280px; height: 24px; margin-bottom: -10px; }
    .reveal-brand__wordmark { transform: translateX(-50%) scale(.6); }
    .confirmacao h1 { font-size: 29px; }
    .confirmacao__card { padding-block: 18px; }
  }
  @media (prefers-reduced-motion: reduce) { .confirmation-step, .confirmation-success { animation: none; } }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-confirmation-form]");

  if (form) {
    const nameInput = form.querySelector<HTMLInputElement>("#nome-confirmacao");
    const continueButton = form.querySelector<HTMLButtonElement>("[data-continue]");
    const nameStep = form.querySelector<HTMLElement>('[data-step="nome"]');
    const choiceStep = form.querySelector<HTMLElement>('[data-step="escolha"]');
    const guestsStep = form.querySelector<HTMLElement>('[data-step="convidados"]');
    const guestFields = form.querySelector<HTMLElement>("[data-guest-fields]");
    const confirmButton = form.querySelector<HTMLButtonElement>("[data-confirm]");
    const success = form.querySelector<HTMLElement>("[data-success]");
    const status = form.querySelector<HTMLElement>("[data-form-status]");
    let levaConvidados: "sim" | "nao" | "" = "";

    const addGuestField = () => {
      if (!guestFields) return;
      const field = document.createElement("div");
      field.className = "guest-field";
      field.innerHTML = '<label>Nome Convidado</label><input class="guest-input" type="text" name="convidado" placeholder="Insira o nome do seu convidado" required aria-label="Nome do convidado" />';
      guestFields.append(field);
    };

    continueButton?.addEventListener("click", () => {
      if (!nameInput?.reportValidity() || !nameStep || !choiceStep) return;
      nameStep.classList.add("is-hidden");
      choiceStep.classList.remove("is-hidden");
    });

    form.querySelectorAll<HTMLButtonElement>("[data-guest-choice]").forEach((choice) => {
      choice.addEventListener("click", () => {
        levaConvidados = choice.dataset.guestChoice === "sim" ? "sim" : "nao";
        form.querySelectorAll<HTMLButtonElement>("[data-guest-choice]").forEach((item) => item.setAttribute("aria-pressed", String(item === choice)));
        if (levaConvidados === "sim") {
          choiceStep?.classList.add("is-hidden");
          guestsStep?.classList.remove("is-hidden");
          if (!guestFields?.children.length) addGuestField();
        }
        if (levaConvidados === "nao") form.requestSubmit();
      });
    });

    form.querySelector<HTMLButtonElement>("[data-add-guest]")?.addEventListener("click", addGuestField);

    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (!levaConvidados || !confirmButton || !nameInput) return;
      const convidados = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="convidado"]')).map((input) => input.value.trim()).filter(Boolean);
      if (levaConvidados === "sim" && convidados.length === 0) { addGuestField(); return; }

      const endpoint = form.dataset.endpoint;
      confirmButton.disabled = true;
      confirmButton.setAttribute("aria-busy", "true");
      if (status) { status.dataset.state = "loading"; status.textContent = "Confirmando sua presença…"; }
      try {
        if (endpoint) {
          const registros = [
            { nome: nameInput.value.trim(), convidado: "Não" },
            ...convidados.map((nome) => ({ nome, convidado: "Sim" })),
          ];

          for (const registro of registros) {
            const payload = new URLSearchParams(registro);
            await fetch(endpoint, {
              method: "POST",
              mode: "no-cors",
              keepalive: true,
              body: payload,
            });
          }
        }
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ event: "FormSubmit", form_id: "hive_event_confirmation" });
        choiceStep?.classList.add("is-hidden");
        guestsStep?.classList.add("is-hidden");
        success?.classList.remove("is-hidden");
        if (status) status.textContent = "";
      } catch (error) {
        confirmButton.disabled = false;
        confirmButton.removeAttribute("aria-busy");
        if (status) { status.dataset.state = "error"; status.textContent = "Não foi possível confirmar agora. Tente novamente."; }
        console.error("[event-confirmation]", error);
      }
    });
  }
</script>
