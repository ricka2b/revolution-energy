---
import Layout from "../layouts/Layout.astro";
import hiveLogo from "../assets/hive-logo.svg";
---

<Layout
  title="Inscrição concluída | Hive Energy"
  description="Sua inscrição para conhecer a oportunidade de Consultor de Energia Hive foi concluída."
  robots="noindex, follow"
  showAnnouncement={false}
  enableMotion={false}
>
  <main class="obrigado" id="conteudo">
    <div class="obrigado__glow obrigado__glow--um" aria-hidden="true"></div>
    <div class="obrigado__glow obrigado__glow--dois" aria-hidden="true"></div>

    <section class="obrigado__card" aria-labelledby="titulo-obrigado">
      <img class="obrigado__logo" src={hiveLogo.src} alt="Hive Energy" />

      <div class="obrigado__check" aria-hidden="true">
        <svg viewBox="0 0 24 24" role="presentation">
          <path d="m5 12.5 4.2 4.2L19 7" />
        </svg>
      </div>

      <h1 id="titulo-obrigado">Parabéns!</h1>
      <p class="obrigado__subtitulo">Sua inscrição foi concluída.</p>
      <span class="obrigado__linha" aria-hidden="true"></span>
      <p class="obrigado__mensagem">
        Nossa equipe entrará em contato com você em instantes.
      </p>
    </section>
  </main>
</Layout>

<style>
  .obrigado {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: clamp(32px, 6vw, 80px) 20px;
    overflow: hidden;
    background:
      radial-gradient(circle at 14% 16%, rgba(127, 96, 253, 0.3), transparent 25%),
      radial-gradient(circle at 88% 82%, rgba(198, 181, 255, 0.18), transparent 28%),
      #0e0a15;
    color: #fff;
  }

  .obrigado::before,
  .obrigado::after {
    content: "";
    position: absolute;
    width: min(72vw, 920px);
    aspect-ratio: 1;
    border: 1px solid rgba(198, 181, 255, 0.12);
    border-radius: 50%;
    pointer-events: none;
  }

  .obrigado::before {
    top: -48%;
    right: -28%;
    box-shadow: 0 0 120px rgba(115, 85, 232, 0.12);
  }

  .obrigado::after {
    bottom: -55%;
    left: -32%;
  }

  .obrigado__glow {
    position: absolute;
    width: 280px;
    aspect-ratio: 1;
    border-radius: 50%;
    background: rgba(115, 85, 232, 0.18);
    filter: blur(90px);
    pointer-events: none;
  }

  .obrigado__glow--um { top: 4%; left: -90px; }
  .obrigado__glow--dois { right: -100px; bottom: 2%; }

  .obrigado__card {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    width: min(100%, 720px);
    padding: clamp(36px, 6vw, 72px);
    border: 1px solid rgba(198, 181, 255, 0.16);
    border-radius: clamp(24px, 4vw, 40px);
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.075), rgba(255, 255, 255, 0.025));
    box-shadow: 0 32px 100px rgba(0, 0, 0, 0.34);
    text-align: center;
    backdrop-filter: blur(12px);
  }

  .obrigado__logo {
    width: clamp(88px, 12vw, 130px);
    height: auto;
    margin-bottom: 30px;
  }

  .obrigado__check {
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    margin-top: 0;
    border-radius: 50%;
    background: linear-gradient(135deg, #7355e8, #8c6eff);
    box-shadow: 0 14px 34px rgba(115, 85, 232, 0.38);
  }

  .obrigado__check svg { width: 28px; height: 28px; }
  .obrigado__check path { fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }

  .obrigado h1 {
    margin-top: 24px;
    font-size: clamp(54px, 10vw, 96px);
    font-weight: 700;
    letter-spacing: -0.06em;
    line-height: 0.95;
  }

  .obrigado__subtitulo {
    margin-top: 18px;
    color: #eeeafd;
    font-size: clamp(22px, 3.5vw, 34px);
    letter-spacing: -0.035em;
    line-height: 1.15;
  }

  .obrigado__linha {
    width: min(100%, 520px);
    height: 1px;
    margin-block: 28px 22px;
    background: linear-gradient(90deg, transparent, rgba(198, 181, 255, 0.65), transparent);
  }

  .obrigado__mensagem {
    color: rgba(255, 255, 255, 0.72);
    font-size: 18px;
    line-height: 1.5;
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    .obrigado__card { padding: 34px 22px; }
    .obrigado__logo { margin-bottom: 24px; }
    .obrigado__mensagem { font-size: 12px; }
  }

</style>
