---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Reconhecimento from "../components/Reconhecimento.astro";
import ComoFunciona from "../components/ComoFunciona.astro";
import Movimentos from "../components/Movimentos.astro";
import Carteira from "../components/Carteira.astro";
import Numeros from "../components/Numeros.astro";
import Recorrencia from "../components/Recorrencia.astro";
import Provas from "../components/Provas.astro";
import SemExperiencia from "../components/SemExperiencia.astro";
import PrimeirosClientes from "../components/PrimeirosClientes.astro";
import Rotina from "../components/Rotina.astro";
import Timing from "../components/Timing.astro";
import CenariosEstaticos from "../components/CenariosEstaticos.astro";
import Fechamento from "../components/Fechamento.astro";
import StaticCta from "../components/StaticCta.astro";
---

<Layout title="Consultor de Energia Hive — versão estática" enableMotion={false}>
  <main id="conteudo" class="pagina-estatica">
    <Hero />
    <Reconhecimento><StaticCta slot="cta" /></Reconhecimento>

    <div class="figma-sections">
      <ComoFunciona><StaticCta slot="cta" /></ComoFunciona>
      <Movimentos><StaticCta slot="cta" /></Movimentos>
      <Carteira><StaticCta slot="cta" /></Carteira>
      <Numeros staticContent />
      <Recorrencia><StaticCta slot="cta" /></Recorrencia>
      <Provas><StaticCta slot="cta" /></Provas>
      <SemExperiencia><StaticCta slot="cta" /></SemExperiencia>
      <PrimeirosClientes><StaticCta slot="cta" /></PrimeirosClientes>
      <Rotina showCalendars><StaticCta slot="cta" /></Rotina>
      <Timing><StaticCta slot="cta" /></Timing>
      <CenariosEstaticos />
    </div>

    <Fechamento />
  </main>
</Layout>

<style is:global>
  #conteudo.pagina-estatica *, #conteudo.pagina-estatica *::before, #conteudo.pagina-estatica *::after {
    animation: none !important;
  }
  #conteudo.pagina-estatica :where(h1, h2, h3, h4, p, li) {
    text-wrap: wrap;
  }

  /* Remove somente a mecânica de palco/trilho da versão interativa. */
  #conteudo.pagina-estatica .process-track {
    height: auto;
    margin-top: 40px;
    margin-bottom: 0;
  }

  #conteudo.pagina-estatica .process {
    position: relative;
    top: auto;
  }

  #conteudo.pagina-estatica .doze__transicao {
    min-height: 0 !important;
    overflow: visible !important;
  }

  #conteudo.pagina-estatica .doze__transicao > .doze__painel {
    position: relative !important;
    inset: auto !important;
    width: 100% !important;
    min-height: 0 !important;
  }

  /* Na versão estática as cenas numéricas formam uma sequência normal. */
  #conteudo.pagina-estatica .numeros__scene {
    position: relative;
    align-items: center;
    justify-content: center;
    min-height: 0;
    padding-block: 0;
  }

  #conteudo.pagina-estatica .numeros__stage {
    display: grid;
    gap: 20px;
    padding-block: 80px 0;
  }

  #conteudo.pagina-estatica .numeros__scene--claro {
    padding-block: clamp(40px, 6vw, 80px);
    background: var(--lavender);
  }

  #conteudo.pagina-estatica .numeros__scene > .s6-frame {
    margin-inline: auto;
    transform: none;
    width: min(90%, 880px);
    max-width: 100%;
  }

  #conteudo.pagina-estatica .head__final { display: none; }
  #conteudo.pagina-estatica .head__initial br { display: none; }
  #conteudo.pagina-estatica .numeros__stage-inner { margin-inline: auto; padding-block: 0; }
  #conteudo.pagina-estatica .numeros__composition {
    position: relative; display: flex; width: min(100%, 1040px); height: auto;
    transform: none; gap: 20px;
  }
  #conteudo.pagina-estatica .numeros :where(.numeros__intro, .head, .premissa__forte, .contas-grid, .consumo-final, .premissa__linha, .premissa__valor, .aquisicao--palco) {
    position: relative; inset: auto; height: auto; max-width: 100%;
  }
  #conteudo.pagina-estatica .numeros__intro, #conteudo.pagina-estatica .consumo-final { display: flex; flex-direction: column; gap: 20px; align-items: center; }
  #conteudo.pagina-estatica .head, #conteudo.pagina-estatica .premissa__forte, #conteudo.pagina-estatica .premissa__linha, #conteudo.pagina-estatica .premissa__valor { white-space: normal; line-height: 1.15; }
  #conteudo.pagina-estatica .contas-grid { grid-template-columns: repeat(10, minmax(0, 1fr)); grid-template-rows: none; }
  #conteudo.pagina-estatica .contas-grid img { width: 100%; height: auto; }
  #conteudo.pagina-estatica .aquisicao--palco { white-space: normal; }
  #conteudo.pagina-estatica .doze__painel { min-height: 0; padding-block: 60px; }

  /* As cenas da recorrência deixam de ocupar o mesmo palco. */
  #conteudo.pagina-estatica .recorrencia__conclusao-palco { min-height: 0; overflow: visible; }
  #conteudo.pagina-estatica .recorrencia__fundo-final { display: none; }
  #conteudo.pagina-estatica :is(.recorrencia__escala, .recorrencia__virada-titulo, .recorrencia__virada-copy) {
    position: relative; inset: auto; height: auto; min-height: 0; max-width: 100%;
  }
  #conteudo.pagina-estatica .recorrencia__escala { padding-block: 40px 60px; }
  #conteudo.pagina-estatica .recorrencia__virada-titulo { width: min(90%, 1040px); white-space: normal; line-height: 1.2; }
  #conteudo.pagina-estatica .recorrencia__virada-copy { padding: 60px 20px; }
  #conteudo.pagina-estatica [data-rec-turn-part="3"] { width: 100%; background: #7355e8; }
  #conteudo.pagina-estatica .recorrencia__ilustracao #renew { display: none; }

  /* Ajustes exclusivos da carta linear. */
  #conteudo.pagina-estatica .mechanism__copy {
    align-self: stretch;
    justify-content: center;
    gap: 24px;
  }
  #conteudo.pagina-estatica .mechanism__copy p {
    font-size: clamp(18px, 2vw, 24px);
    line-height: 1.4;
    letter-spacing: -.025em;
  }
  #conteudo.pagina-estatica .bridge__copy { gap: 24px; }
  #conteudo.pagina-estatica .bridge__copy p,
  #conteudo.pagina-estatica .bridge__copy p + p {
    font-size: clamp(18px, 1.8vw, 22px);
    line-height: 1.4;
    letter-spacing: -.025em;
  }
  #conteudo.pagina-estatica .not-needed {
    height: auto;
    min-height: 0;
    max-width: 100%;
    padding: 36px 32px 40px;
    display: grid;
    gap: 24px;
  }
  #conteudo.pagina-estatica .not-needed h3 {
    white-space: normal;
    line-height: 1.2;
    text-box-trim: none;
  }
  #conteudo.pagina-estatica .not-needed ul { margin: 0; gap: 14px; }
  #conteudo.pagina-estatica .not-needed li { gap: 10px; line-height: 1.5; }
  #conteudo.pagina-estatica .not-needed li img { flex: none; }
  #conteudo.pagina-estatica .not-needed li span { text-box-trim: none; }
  @media (max-width: 47.5rem) {
    #conteudo.pagina-estatica .not-needed { padding: 28px 24px 32px; }
  }
  #conteudo.pagina-estatica .fechamento .pergunta {
    background: #7355e8;
    color: #fff;
    border: 1px solid rgba(255,255,255,.25);
    animation: static-question-pulse 2.8s ease-in-out infinite !important;
  }
  #conteudo.pagina-estatica .fechamento .pergunta p { color: #fff; }
  @keyframes static-question-pulse {
    0%, 100% { background-color: #7355e8; box-shadow: 0 0 0 0 rgba(127,96,253,0); }
    50% { background-color: #8263ee; box-shadow: 0 0 30px 5px rgba(127,96,253,.3); }
  }
  @media (prefers-reduced-motion: reduce) {
    #conteudo.pagina-estatica .fechamento .pergunta { animation: none !important; }
  }
  #conteudo.pagina-estatica .timing__inicio,
  #conteudo.pagina-estatica .timing__argumento {
    justify-items: center;
    text-align: center;
  }
  #conteudo.pagina-estatica .timing__amadurece,
  #conteudo.pagina-estatica .timing__decisao,
  #conteudo.pagina-estatica .timing__argumento h3 {
    margin-inline: auto;
    text-align: center;
  }
  #conteudo.pagina-estatica .timing__quote {
    width: 100%;
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }
  #conteudo.pagina-estatica #formulario-carta { scroll-margin-top: calc(var(--bar-h) + 24px); }
  #conteudo.pagina-estatica .carteira__conceito { justify-items: center; margin-inline: auto; }
  #conteudo.pagina-estatica .carteira__conceito h3 { width: fit-content; max-width: 100%; margin-inline: auto; text-align: center; }
  #conteudo.pagina-estatica .numeros > .static-cta { background: var(--lavender); }
  #conteudo.pagina-estatica .primeiros__cabecalho,
  #conteudo.pagina-estatica .primeiros__cabecalho > div,
  #conteudo.pagina-estatica .primeiros__exercicio header {
    width: 100%;
    text-align: center;
    align-items: center;
    justify-items: center;
  }
  #conteudo.pagina-estatica .numeros__scene[data-num-scene="3"] {
    padding-bottom: 60px;
  }
  #conteudo.pagina-estatica .primeiros__mensagem > h3 {
    width: 100%;
    white-space: nowrap;
    text-wrap: nowrap;
    font-size: clamp(18px, 4.1vw, 56px);
    line-height: 1.2;
    letter-spacing: -.03em;
  }
  #conteudo.pagina-estatica .rotina__avanco h3 {
    white-space: nowrap;
    text-wrap: nowrap;
    font-size: clamp(24px, 5.6vw, 64px);
    line-height: 1.2;
    letter-spacing: -.03em;
    text-align: center;
  }
  #conteudo.pagina-estatica .cenario {
    justify-items: center;
    margin-inline: auto;
    text-align: center;
  }
  #conteudo.pagina-estatica .cenario > div {
    font-size: clamp(22px, 2.9vw, 32px);
    width: 100%;
    justify-items: center;
    text-align: center;
  }
  #conteudo.pagina-estatica .cenario > span {
    font-size: clamp(22px, 2.9vw, 32px);
    max-width: 100%;
  }
  #conteudo.pagina-estatica .experiencia__resposta ul {
    display: flex;
    flex-wrap: nowrap;
    justify-content: center;
    width: 100%;
    height: auto;
    container-type: inline-size;
  }
  #conteudo.pagina-estatica .experiencia__resposta li {
    flex: 0 1 auto;
    width: auto;
    height: auto;
    padding: 10px .8em;
    font-size: clamp(5px, 1.65cqw, 18px);
    white-space: nowrap;
    text-align: center;
  }
  #conteudo.pagina-estatica .experiencia__resposta li p {
    white-space: nowrap;
    text-wrap: nowrap;
  }
  #conteudo.pagina-estatica .experiencia__resposta li + li {
    border-top: 0;
    border-left: 1px solid rgba(255,255,255,.3);
  }
  #conteudo.pagina-estatica .experiencia__typing {
    width: 100%;
    max-width: 100%;
  }
  #conteudo.pagina-estatica .experiencia__pergunta h2 {
    width: 100%;
    max-width: 100%;
    white-space: nowrap;
    text-wrap: nowrap;
    font-size: clamp(15px, 4.4vw, 60px);
    line-height: 1.2;
    letter-spacing: -0.03em;
    text-align: center;
  }
  #conteudo.pagina-estatica .recorrencia__virada-frase--parte2 {
    width: 100%;
    max-width: 100%;
    white-space: nowrap;
    text-wrap: nowrap;
    font-size: clamp(14px, 3.6vw, 48px);
    line-height: 1.2;
    letter-spacing: -0.025em;
    text-align: center;
  }
  #conteudo.pagina-estatica .s6-4__titulo {
    width: 100%;
    max-width: 100%;
    white-space: nowrap;
    text-wrap: nowrap;
    text-align: center;
    font-size: clamp(20px, 4.8vw, 54px);
    line-height: 1.2;
  }
  #conteudo.pagina-estatica .carteira__header {
    width: 100%;
    min-width: 0;
    margin-inline: auto;
    justify-items: center;
    text-align: center;
  }
  #conteudo.pagina-estatica .movimentos__frase {
    width: 100%;
    text-align: center;
    white-space: nowrap;
    text-wrap: nowrap;
    font-size: clamp(8px, 2.25vw, 25px);
    line-height: 1.4;
    letter-spacing: -.03em;
  }
  #conteudo.pagina-estatica .consumo-final { width: 100%; container-type: inline-size; }
  #conteudo.pagina-estatica .premissa__valor {
    display: flex; flex-wrap: nowrap; justify-content: center; gap: .18em;
    width: 100%; white-space: nowrap; font-size: clamp(20px, 6.5cqw, 68px);
  }
  #conteudo.pagina-estatica .aquisicao--palco {
    width: 100%; white-space: nowrap; font-size: clamp(7px, 1.92cqw, 20px);
    line-height: 1.5; letter-spacing: -.03em;
  }
  #conteudo.pagina-estatica .static-next-arrow {
    display: block; flex: none; width: 36px; height: 36px; margin: 16px auto 0;
    color: #c6b5ff; animation: static-arrow-float 1.8s ease-in-out infinite !important;
  }
  @keyframes static-arrow-float {
    0%, 100% { transform: translateY(-5px); }
    50% { transform: translateY(5px); }
  }
  @media (prefers-reduced-motion: reduce) {
    #conteudo.pagina-estatica .static-next-arrow { animation: none !important; }
  }
  #conteudo.pagina-estatica [data-rec-turn-part="3"] {
    width: min(calc(100% - 40px), 1040px); padding: 56px 32px; border-radius: 32px;
    background: linear-gradient(135deg, #8263f2, #6847d4);
    border: 1px solid rgba(255,255,255,.24);
    box-shadow: 0 32px 64px -24px rgba(63,35,137,.42), 0 10px 24px -12px rgba(63,35,137,.25), inset 0 1px 0 rgba(255,255,255,.2);
  }
  #conteudo.pagina-estatica .recorrencia__inner { padding-bottom: 64px; }
  #conteudo.pagina-estatica .recorrencia__conclusao-track { width: 100%; margin-left: 0; }
  #conteudo.pagina-estatica .recorrencia__virada-frase--parte3 {
    font-size: clamp(24px, 4.5vw, 58px);
    line-height: 1.25;
    letter-spacing: -4px;
  }
  #conteudo.pagina-estatica .recorrencia__virada-frase--parte3 span + span::before {
    content: " ";
    white-space: pre;
  }
  #conteudo.pagina-estatica .experiencia__painel header { align-items: center; text-align: center; }
  #conteudo.pagina-estatica .experiencia__fluxo {
    width: fit-content;
    max-width: 100%;
    height: auto;
    padding: 30px 48px;
    justify-content: center;
    gap: 26px;
    border: 1px solid rgba(255,255,255,.22);
    border-radius: 28px;
    background: linear-gradient(135deg, #8263f2, #6847d4);
    color: #fff;
    box-shadow: 0 18px 40px -16px rgba(115,85,232,.5), inset 0 1px 0 rgba(255,255,255,.18);
  }
  #conteudo.pagina-estatica .experiencia__fecho { height: auto; }
  #conteudo.pagina-estatica .experiencia__fluxo img { filter: brightness(0) invert(1); }
  #conteudo.pagina-estatica .experiencia__cursor { display: none; }
  #conteudo.pagina-estatica .primeiros__inner { padding-bottom: 0; }
  #conteudo.pagina-estatica .primeiros { height: auto; min-height: 0; }
  #conteudo.pagina-estatica .primeiros__mensagem { min-height: 0; }
  #conteudo.pagina-estatica .primeiros__mensagem-grid { align-items: end; }
  #conteudo.pagina-estatica .primeiros__fecho { align-self: center; }
  #conteudo.pagina-estatica .rotina__intro { width: 100%; text-align: center; justify-items: center; }
  #conteudo.pagina-estatica .rotina__apoio { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; width: 100%; }
  #conteudo.pagina-estatica .rotina__apoio p {
    display: grid; place-items: center; padding: 24px 20px; border-radius: 20px;
    background: #7355e8; color: #fff; line-height: 1.4;
  }
  #conteudo.pagina-estatica .semana strong { font-size: 24px; line-height: 1.2; letter-spacing: .02em; }
  #conteudo.pagina-estatica .semana li {
    gap: 16px;
    background: #fff;
  }
  #conteudo.pagina-estatica .semana span { line-height: 1.5; }
  #conteudo.pagina-estatica .semana li:nth-child(2) {
    background: #0e0a15;
    color: #fff;
    border-color: rgba(255,255,255,.12);
  }
  #conteudo.pagina-estatica .semana li:nth-child(2) strong { color: #c6b5ff; }
  #conteudo.pagina-estatica .cenario {
    width: min(100%, 1040px);
    max-width: 1040px;
    padding: 48px clamp(20px, 4vw, 56px);
    border-radius: 32px;
    border: 1px solid rgba(255,255,255,.14);
    box-shadow: 0 24px 50px -24px rgba(14,10,21,.3);
    color: #fff;
  }
  #conteudo.pagina-estatica .cenario--um { background: #0e0a15; }
  #conteudo.pagina-estatica .cenario--um > span {
    color: #fff;
    border-color: rgba(255,255,255,.35);
  }
  #conteudo.pagina-estatica .cenario--dois {
    background: linear-gradient(135deg, #8263f2, #6847d4);
  }
  #conteudo.pagina-estatica .doze__painel--dois { background: #f7f6f9; }
  #conteudo.pagina-estatica .timing__top h2 {
    width: 100%; max-width: 1040px; font-size: clamp(18px, 3.2vw, 40px);
    line-height: 1.2; text-align: center; text-wrap: balance;
  }
  #conteudo.pagina-estatica .timing__top h2 br { display: none; }
  #conteudo.pagina-estatica .doze__painel--um { background: #f7f6f9; }
  #conteudo.pagina-estatica .doze__painel--um .doze__cabecalho {
    width: min(100%, 1040px); max-width: 1040px; padding: 40px 24px;
    border-radius: 28px; background: #fff;
    box-shadow: 0 24px 60px -24px rgba(14,10,21,.22), 0 4px 12px rgba(14,10,21,.04);
    margin-bottom: 60px;
  }
  #conteudo.pagina-estatica .doze__transicao > .doze__painel { padding-block: 80px; }
  #conteudo.pagina-estatica .doze__transicao > .doze__painel--um { padding-bottom: 20px; }
  #conteudo.pagina-estatica .doze__transicao > .doze__painel--dois { padding-top: 20px; }
  #conteudo.pagina-estatica .cenario { margin-top: 0; }
  #conteudo.pagina-estatica .doze__painel--dois .doze__cabecalho { display: none; }

  @media (max-width: 47.5rem) {
    #conteudo.pagina-estatica .cenario > div { font-size: 16px; }
    #conteudo.pagina-estatica .cenario > span { font-size: 15px; }
    #conteudo.pagina-estatica .experiencia__fluxo {
      width: min(100%, 380px);
      padding: 26px 18px;
      gap: 12px;
      border-radius: 22px;
    }
    #conteudo.pagina-estatica .timing__top h2 { font-size: clamp(12px, 3.4vw, 24px); }
    #conteudo.pagina-estatica .rotina__apoio { gap: 8px; }
    #conteudo.pagina-estatica .rotina__apoio p { padding: 16px 8px; font-size: 12px; border-radius: 12px; }
    #conteudo.pagina-estatica [data-rec-turn-part="3"] { width: 100%; padding: 32px 16px; border-radius: 24px; }
    #conteudo.pagina-estatica .primeiros__telefone { order: 2; }
    #conteudo.pagina-estatica .primeiros__fecho { order: 1; }
    #conteudo.pagina-estatica .doze__painel--um .doze__cabecalho > p { width: 100%; white-space: normal; }
  }

  @media (max-width: 47.5rem) {
    #conteudo.pagina-estatica .figma-sections :where(
      .movimentos__header h2,
      .provas__cabecalho h2,
      .primeiros__cabecalho h2,
      .doze__cabecalho h2
    ) {
      font-size: clamp(36px, 7.3vw, 80.359px);
      line-height: 100%;
      letter-spacing: -0.05em;
    }

    #conteudo.pagina-estatica .figma-sections br,
    #conteudo.pagina-estatica .fechamento br {
      display: none;
    }

    #conteudo.pagina-estatica .figma-sections :where(h1, h2, h3, h4) > span,
    #conteudo.pagina-estatica .fechamento :where(h1, h2, h3, h4) > span {
      white-space: normal;
    }

    #conteudo.pagina-estatica .doze__transicao > .doze__painel {
      min-height: 0 !important;
    }
  }
  #conteudo.pagina-estatica .carteira__conceito > p { width: 100%; text-align: center; }
  #conteudo.pagina-estatica .recorrencia__header,
  #conteudo.pagina-estatica .recorrencia__heading {
    width: 100%; align-items: center; text-align: center; margin-inline: auto;
  }
  #conteudo.pagina-estatica .recorrencia__header :is(p, h2) { text-align: center; }
  #conteudo.pagina-estatica .experiencia__fecho h3 {
    width: 100%; white-space: nowrap; text-wrap: nowrap;
    font-size: clamp(12px, 3.7vw, 46px); line-height: 1.25;
  }
  #conteudo.pagina-estatica .rotina__intro h2 {
    width: 100%; max-width: 100%; white-space: nowrap; text-wrap: nowrap;
    font-size: clamp(16px, 4.1vw, 50px); line-height: 1.2;
  }
  #conteudo.pagina-estatica .rotina__intro h2 br { display: none; }
  #conteudo.pagina-estatica .rotina__apoio { grid-template-columns: 1fr 1.4fr .9fr; gap: 12px; }
  #conteudo.pagina-estatica .rotina__apoio p {
    padding-inline: 12px; white-space: nowrap; text-wrap: nowrap;
    font-size: clamp(10px, 1.35vw, 15px);
  }
